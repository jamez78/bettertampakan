{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Municipal Departments",
  "description": "Schema for local government administrative offices",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["slug", "office_name"],
    "properties": {
      "slug": {
        "type": "string",
        "description": "URL-friendly identifier"
      },
      "office_name": {
        "type": "string",
        "description": "Official name of the office"
      },
      "address": {
        "type": ["string", "null"]
      },
      "trunkline": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": ["string", "null"]
            }
          },
          {
            "type": "null"
          }
        ],
        "description": "Array of phone numbers (items can be null) or null"
      },
      "website": {
        "type": ["string", "null"],
        "format": "uri"
      },
      "email": {
        "type": ["string", "null"],
        "format": "email",
        "description": "Official office email address"
      },
      "department_head": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": ["string", "null"]
              },
              "contact": {
                "type": ["string", "null"]
              },
              "email": {
                "type": ["string", "null"],
                "format": "email"
              },
              "title": {
                "type": ["string", "null"],
                "description": "Position shown instead of 'Department Head', e.g. College Administrator"
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "staff": {
        "type": "array",
        "description": "Optional list of staff members: name (with credentials) and position",
        "items": {
          "type": "object",
          "required": ["name", "role"],
          "properties": {
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          }
        }
      },
      "sections": {
        "type": "array",
        "description": "Optional named lists of people shown on the office page (for example accredited guides)",
        "items": {
          "type": "object",
          "required": ["title", "members"],
          "properties": {
            "title": {
              "type": "string"
            },
            "note": {
              "type": ["string", "null"]
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": ["string", "null"]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
