{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Executive Orders",
  "description": "Schema for executive orders issued by the Municipal Mayor, shown as plain-language summaries",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "slug",
      "number",
      "series",
      "title",
      "short_title",
      "signed",
      "effectivity",
      "signatory"
    ],
    "properties": {
      "slug": {
        "type": "string",
        "description": "URL-friendly identifier, e.g. eo-40-s-2026"
      },
      "number": {
        "type": "string",
        "description": "Executive order number, e.g. \"40\""
      },
      "series": {
        "type": "integer",
        "description": "Series year, e.g. 2026"
      },
      "title": {
        "type": "string",
        "description": "Full title of the order"
      },
      "short_title": {
        "type": "string",
        "description": "Short plain-language title for lists"
      },
      "signed": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date signed, YYYY-MM-DD"
      },
      "effectivity": {
        "type": "string"
      },
      "signatory": {
        "type": "object",
        "required": ["name", "title"],
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "source": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "url": {
                "type": ["string", "null"],
                "format": "uri",
                "description": "Link to the LGU post; null falls back to the LGU Facebook page"
              },
              "label": {
                "type": ["string", "null"]
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "summary_fil": {
        "type": ["string", "null"],
        "description": "Short Filipino summary shown at the top of the page"
      },
      "tables": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "columns", "rows"],
          "properties": {
            "title": {
              "type": "string"
            },
            "note": {
              "type": ["string", "null"]
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "key_points": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["heading", "points"],
          "properties": {
            "heading": {
              "type": "string"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
